{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated player profile and cumulative campus stats.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "nickname": { "type": "string", "description": "Display nickname (1-18 chars)" },
        "matchesPlayed": { "type": "integer", "description": "Total completed matches" },
        "totalPoints": { "type": "integer", "description": "Cumulative career points" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "nickname", "matchesPlayed", "totalPoints", "createdAt", "updatedAt"]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Multiplayer Proxy Wars match room state.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "description": "4-character uppercase room code" },
        "hostId": { "type": "string", "description": "Room host Firebase UID" },
        "memberUids": { "type": "array", "description": "Up to 10 member UIDs" },
        "phase": {
          "type": "string",
          "enum": ["LOBBY", "ROLE_REVEAL", "PROMPT", "DEBATE", "VOTE", "REVEAL", "MATCH_END"],
          "description": "Authoritative match phase"
        },
        "phaseEndsAtMs": { "type": "integer", "description": "Epoch ms when phase ends" },
        "phaseDurationMs": { "type": "integer", "description": "Phase duration in ms" },
        "roundNum": { "type": "integer", "description": "Current round number (1-3)" },
        "totalRounds": { "type": "integer", "description": "Total rounds in match" },
        "openTable": { "type": "boolean", "description": "True if listed in Open Table matchmaker" },
        "promptId": { "type": "string", "description": "Active prompt identifier" },
        "promptCategory": { "type": "string", "description": "Active prompt category" },
        "promptText": { "type": "string", "description": "Active prompt text" },
        "humansWonRound": { "type": "boolean", "description": "True if Humans caught Glitch in round" },
        "glitchPlayerIds": { "type": "array", "description": "Revealed Glitch UIDs after voting" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["roomCode", "hostId", "memberUids", "phase", "phaseEndsAtMs", "phaseDurationMs", "roundNum", "totalRounds", "openTable", "createdAt", "updatedAt"]
    },
    "RoomPlayer": {
      "title": "RoomPlayer",
      "description": "Public player roster entry inside a room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "memberUids": { "type": "array" },
        "nickname": { "type": "string" },
        "hostFlag": { "type": "boolean" },
        "score": { "type": "integer" },
        "totalVoteTimeMs": { "type": "integer" },
        "hasSubmittedAnswer": { "type": "boolean" },
        "hasVoted": { "type": "boolean" },
        "mySubmittedAnswerId": { "type": "string" },
        "lockedVoteAnswerId": { "type": "string" },
        "lastRoundDelta": { "type": "integer" },
        "lastRoundTags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "hostId", "memberUids", "nickname", "hostFlag", "score", "totalVoteTimeMs", "hasSubmittedAnswer", "hasVoted", "createdAt", "updatedAt"]
    },
    "RoundSecret": {
      "title": "RoundSecret",
      "description": "Private per-player role and Glitch AI options.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "memberUids": { "type": "array" },
        "roundNum": { "type": "integer" },
        "role": { "type": "string", "enum": ["HUMAN", "GLITCH"] },
        "aiOptions": { "type": "array" },
        "rerollUsed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "hostId", "memberUids", "roundNum", "role", "aiOptions", "rerollUsed", "createdAt", "updatedAt"]
    },
    "AnswerDraft": {
      "title": "AnswerDraft",
      "description": "Player-submitted round answer readable only by author and host.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "roundNum": { "type": "integer" },
        "answerText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "hostId", "roundNum", "answerText", "createdAt", "updatedAt"]
    },
    "VoteRecord": {
      "title": "VoteRecord",
      "description": "Player vote record readable only by voter and host.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "roundNum": { "type": "integer" },
        "targetAnswerId": { "type": "string" },
        "elapsedMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "hostId", "roundNum", "targetAnswerId", "elapsedMs", "createdAt", "updatedAt"]
    },
    "PublicAnswer": {
      "title": "PublicAnswer",
      "description": "Shuffled anonymous answer card revealed to the room during Debate, Vote, and Reveal.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "memberUids": { "type": "array" },
        "roundNum": { "type": "integer" },
        "label": { "type": "string" },
        "text": { "type": "string" },
        "revealed": { "type": "boolean" },
        "authorId": { "type": "string" },
        "authorNickname": { "type": "string" },
        "role": { "type": "string", "enum": ["HUMAN", "GLITCH"] },
        "voterNicknames": { "type": "array" },
        "voteCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "hostId", "memberUids", "roundNum", "label", "text", "revealed", "voteCount", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public campus leaderboard entry updated after each AI-detection round.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "nickname": { "type": "string" },
        "totalPoints": { "type": "integer" },
        "lastRoundDelta": { "type": "integer" },
        "roundsPlayed": { "type": "integer" },
        "glitchesCaught": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "nickname", "totalPoints", "lastRoundDelta", "roundsPlayed", "glitchesCaught", "createdAt", "updatedAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Real-time text chat message sent by a player inside a game room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "memberUids": { "type": "array" },
        "senderNickname": { "type": "string" },
        "text": { "type": "string" },
        "roundNum": { "type": "integer" },
        "phase": {
          "type": "string",
          "enum": ["LOBBY", "ROLE_REVEAL", "PROMPT", "DEBATE", "VOTE", "REVEAL", "MATCH_END"]
        },
        "clientSentAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "hostId", "memberUids", "senderNickname", "text", "roundNum", "phase", "clientSentAtMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and cumulative stats."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Campus global leaderboard standings updated after each round."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Top-level multiplayer game rooms keyed by 4-character room code."
    },
    "/rooms/{roomId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/RoomPlayer" },
      "description": "Active players inside a room."
    },
    "/rooms/{roomId}/secrets/{playerId}": {
      "schema": { "$ref": "#/entities/RoundSecret" },
      "description": "Private role and Glitch AI options isolated per player."
    },
    "/rooms/{roomId}/drafts/{playerId}": {
      "schema": { "$ref": "#/entities/AnswerDraft" },
      "description": "Private round submission prior to host shuffle."
    },
    "/rooms/{roomId}/votes/{playerId}": {
      "schema": { "$ref": "#/entities/VoteRecord" },
      "description": "Player vote record for the round."
    },
    "/rooms/{roomId}/public_answers/{answerId}": {
      "schema": { "$ref": "#/entities/PublicAnswer" },
      "description": "Anonymized (and later unmasked) answer cards for Debate, Vote, and Reveal."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "In-room chat messages shared among active room members across rounds."
    }
  }
}
